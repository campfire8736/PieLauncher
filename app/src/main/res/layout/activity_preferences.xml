<merge xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">
	<de.markusfisch.android.pielauncher.widget.ScrollWithListenerView
		android:id="@+id/content"
		android:clipToPadding="false"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<de.markusfisch.android.pielauncher.widget.preference.PreferenceCardView
				android:id="@+id/setup_card"
				style="@style/PreferenceCard"
				android:layout_marginTop="16dp">
				<de.markusfisch.android.pielauncher.widget.preference.PreferenceActionView
					android:id="@+id/welcome"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:title="@string/check_these_settings"
					app:icon="@drawable/ic_info" />
				<de.markusfisch.android.pielauncher.widget.preference.PreferenceActionView
					android:id="@+id/disable_battery_optimization"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:title="@string/disable_battery_optimization" />
				<de.markusfisch.android.pielauncher.widget.preference.PreferenceActionView
					android:id="@+id/make_default_launcher"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:title="@string/make_default_launcher" />
			</de.markusfisch.android.pielauncher.widget.preference.PreferenceCardView>

			<LinearLayout
				android:id="@+id/hide_in_welcome_mode"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<de.markusfisch.android.pielauncher.widget.preference.PreferenceCardView
					style="@style/PreferenceCard"
					android:layout_marginTop="16dp">
					<TextView
						style="@style/CategoryHeader"
						android:text="@string/category_home" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/orientation"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/orientation" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/darken_background"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/darken_background" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSliderView
						android:id="@+id/blur_background"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/blur_background" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/blur_menu"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/blur_menu" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/dead_zone"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/dead_zone" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/expand_panel_in_dead_zone"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/expand_panel_in_dead_zone" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/immersive_mode"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/immersive_mode" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/animate_in_out"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/animate_in_out" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/split_pie_menu"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/split_pie_menu" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/circle_swaps_menus"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/circle_swaps_menus" />
				</de.markusfisch.android.pielauncher.widget.preference.PreferenceCardView>

				<de.markusfisch.android.pielauncher.widget.preference.PreferenceCardView
					style="@style/PreferenceCard">
					<TextView
						style="@style/CategoryHeader"
						android:text="@string/category_app_drawer" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/display_keyboard"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/display_keyboard" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/home_button_opens_drawer"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/home_button_opens_drawer" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/open_list_with"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/open_list_with" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/list_animation_appearance"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/list_animation_appearance" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/app_sorting"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/app_sorting" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/show_app_names"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/show_app_names" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/auto_launch_matching"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/auto_launch_matching" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/remember_search_picks"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/remember_search_picks" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/search_strictness"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/search_strictness" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/search_parameter"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/search_parameter" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/space_action"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/space_action" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/show_app_shortcuts"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/show_app_shortcuts" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/exclude_pie"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/exclude_pie" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/icon_press"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/icon_press" />
				</de.markusfisch.android.pielauncher.widget.preference.PreferenceCardView>

				<de.markusfisch.android.pielauncher.widget.preference.PreferenceCardView
					style="@style/PreferenceCard">
					<TextView
						style="@style/CategoryHeader"
						android:text="@string/category_advanced" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/icon_pack"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/icon_pack" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceActionView
						android:id="@+id/hidden_apps"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/hidden_apps"
						app:icon="@drawable/ic_hide" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceChoiceView
						android:id="@+id/haptic_feedback"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/haptic_feedback" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/use_light_dialogs"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/use_light_dialogs" />
					<de.markusfisch.android.pielauncher.widget.preference.PreferenceSwitchView
						android:id="@+id/force_relaunch"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:title="@string/force_relaunch" />
				</de.markusfisch.android.pielauncher.widget.preference.PreferenceCardView>
			</LinearLayout>
			<Button
				style="@style/Button"
				android:id="@+id/skip"
				android:layout_gravity="center_horizontal"
				android:layout_margin="16dp"
				android:text="@string/skip" />
		</LinearLayout>
	</de.markusfisch.android.pielauncher.widget.ScrollWithListenerView>
	<TextView
		style="@style/Toolbar"
		android:id="@+id/toolbar"
		android:background="@color/bg_ui"
		android:drawableLeft="@drawable/ic_back"
		android:drawableStart="@drawable/ic_back"
		android:text="@string/preferences" />
</merge>
