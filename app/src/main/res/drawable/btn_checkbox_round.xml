<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_checked="true">
		<layer-list>
			<item>
				<shape android:shape="oval">
					<size android:width="20dp" android:height="20dp"/>
					<solid android:color="?android:attr/colorAccent"/>
				</shape>
			</item>
			<item
				android:top="3dp"
				android:bottom="3dp"
				android:left="3dp"
				android:right="3dp"
				android:drawable="@drawable/ic_check_small"/>
		</layer-list>
	</item>
	<item>
		<shape android:shape="oval">
			<size android:width="20dp" android:height="20dp"/>
			<solid android:color="?attr/colorUiBackground"/>
			<stroke
				android:width="2dp"
				android:color="?attr/colorSwitchTrackOutline"/>
		</shape>
	</item>
</selector>
