<merge
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:android="http://schemas.android.com/apk/res/android">
	<de.markusfisch.android.pielauncher.widget.AppPieView
		android:id="@+id/pie"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scrollbars="vertical"/>
	<LinearLayout
		android:id="@+id/top_container"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">
		<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content">
			<TextView
				style="@style/Toolbar"
				android:id="@+id/toolbar"
				android:drawableLeft="@drawable/ic_back"
				android:drawableStart="@drawable/ic_back"
				android:visibility="gone"/>
			<ImageView
				android:id="@+id/toolbar_edit"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_alignParentRight="true"
				android:layout_alignParentEnd="true"
				android:layout_alignBottom="@+id/toolbar"
				android:layout_marginBottom="4dp"
				android:layout_marginRight="8dp"
				android:layout_marginEnd="8dp"
				android:padding="12dp"
				android:src="@drawable/ic_edit"
				android:contentDescription="@string/edit_folder"
				android:background="?android:attr/selectableItemBackgroundBorderless"
				android:visibility="gone"/>
		</RelativeLayout>
		<FrameLayout
			android:id="@+id/floating_toolbar"
			android:layout_width="match_parent"
			android:layout_height="48dp"
			android:layout_marginLeft="16dp"
			android:layout_marginStart="16dp"
			android:layout_marginRight="16dp"
			android:layout_marginEnd="16dp"
			android:layout_marginTop="8dp"
			android:visibility="gone">
			<EditText
				tools:ignore="LabelFor"
				android:id="@+id/search"
				android:background="@android:color/transparent"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:paddingLeft="16dp"
				android:paddingStart="16dp"
				android:paddingRight="96dp"
				android:paddingEnd="96dp"
				android:drawableLeft="@drawable/ic_search"
				android:drawableStart="@drawable/ic_search"
				android:drawablePadding="12dp"
				android:inputType="textNoSuggestions|textFilter|textVisiblePassword"
				android:imeOptions="actionSearch|flagNoExtractUi"
				android:privateImeOptions="nm"
				android:gravity="center_vertical"
				android:hint="@string/category_search"
				android:textColor="?android:attr/textColorPrimary"
				android:textColorHint="?android:attr/textColorSecondary"
				android:maxLines="1"
				android:maxLength="128"
				android:importantForAutofill="no"/>
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:layout_gravity="end|center_vertical"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingRight="4dp"
				android:paddingEnd="4dp">
				<de.markusfisch.android.pielauncher.widget.ActionButton
					android:id="@+id/edit"
					android:layout_width="44dp"
					android:layout_height="44dp"
					android:padding="10dp"
					android:contentDescription="@string/edit_pie_menu"
					android:src="@drawable/ic_edit"
					android:visibility="gone"/>
				<de.markusfisch.android.pielauncher.widget.ActionButton
					android:id="@+id/preferences"
					android:layout_width="44dp"
					android:layout_height="44dp"
					android:padding="10dp"
					android:contentDescription="@string/preferences"
					android:src="@drawable/ic_preferences"
					android:visibility="gone"/>
			</LinearLayout>
		</FrameLayout>
	</LinearLayout>
</merge>
