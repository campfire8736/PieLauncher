<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<de.markusfisch.android.pielauncher.widget.preference.PreferenceCardView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:background="@drawable/bg_dialog_card"
		android:layout_margin="0dp">

		<TextView
			android:id="@+id/dialog_title"
			style="@style/PreferenceTitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="20dp"
			android:paddingBottom="14dp"
			android:paddingLeft="20dp"
			android:paddingRight="20dp"
			android:paddingStart="20dp"
			android:paddingEnd="20dp"
			android:textSize="18sp"
			android:textStyle="bold" />

		<View
			android:id="@+id/dialog_title_divider"
			android:layout_width="match_parent"
			android:layout_height="1px"
			android:background="@color/preference_divider" />

		<de.markusfisch.android.pielauncher.widget.MaxHeightScrollView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:overScrollMode="ifContentScrolls">

			<LinearLayout
				android:id="@+id/options_container"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:showDividers="middle"
				android:divider="@drawable/preference_divider" />
		</de.markusfisch.android.pielauncher.widget.MaxHeightScrollView>
	</de.markusfisch.android.pielauncher.widget.preference.PreferenceCardView>
</FrameLayout>
