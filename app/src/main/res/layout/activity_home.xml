<merge
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:android="http://schemas.android.com/apk/res/android">
	<de.markusfisch.android.pielauncher.widget.AppPieView
		android:id="@+id/pie"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scrollbars="vertical"/>
	<LinearLayout
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:background="?attr/colorSearchBar"
		android:visibility="gone">
		<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="44dp"
			android:paddingLeft="16dp"
			android:paddingStart="16dp"
			android:paddingRight="8dp"
			android:paddingEnd="8dp">
			<TextView
				android:id="@+id/toolbar_title"
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:layout_alignParentLeft="true"
				android:layout_alignParentStart="true"
				android:gravity="center_vertical"
				android:textColor="?android:attr/textColorPrimary"
				android:textSize="20sp"
				android:textStyle="bold"
				android:text="@string/category_app_drawer"/>
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:layout_alignParentRight="true"
				android:layout_alignParentEnd="true"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<de.markusfisch.android.pielauncher.widget.ActionButton
					android:id="@+id/edit"
					android:layout_width="44dp"
					android:layout_height="44dp"
					android:padding="10dp"
					android:contentDescription="@string/edit_pie_menu"
					android:src="@drawable/ic_edit"
					android:visibility="gone"/>
				<de.markusfisch.android.pielauncher.widget.ActionButton
					android:id="@+id/preferences"
					android:layout_width="44dp"
					android:layout_height="44dp"
					android:padding="10dp"
					android:contentDescription="@string/preferences"
					android:src="@drawable/ic_preferences"
					android:visibility="gone"/>
			</LinearLayout>
		</RelativeLayout>
		<EditText
			tools:ignore="LabelFor"
			android:id="@+id/search"
			android:background="@android:color/transparent"
			android:layout_width="match_parent"
			android:layout_height="36dp"
			android:layout_marginLeft="16dp"
			android:layout_marginStart="16dp"
			android:layout_marginRight="16dp"
			android:layout_marginEnd="16dp"
			android:layout_marginBottom="8dp"
			android:paddingLeft="8dp"
			android:paddingStart="8dp"
			android:paddingRight="8dp"
			android:paddingEnd="8dp"
			android:inputType="textNoSuggestions|textFilter|textVisiblePassword"
			android:imeOptions="actionSearch|flagNoExtractUi"
			android:privateImeOptions="nm"
			android:gravity="center_vertical"
			android:hint="@string/category_search"
			android:textColor="?android:attr/textColorPrimary"
			android:textColorHint="?android:attr/textColorSecondary"
			android:maxLines="1"
			android:maxLength="128"
			android:importantForAutofill="no"/>
	</LinearLayout>
</merge>
