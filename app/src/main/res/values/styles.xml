<resources>
	<style name="HomeTheme" parent="android:Theme.DeviceDefault.NoActionBar">
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:windowShowWallpaper">true</item>
		<item name="android:alertDialogTheme">@style/DarkDialog</item>
		<item name="android:textColorPrimary">@color/text_color</item>
		<item name="android:textColorSecondary">@color/text_color_preference</item>
		<item name="colorUiBackground">@color/bg_ui</item>
		<item name="colorSearchBar">@color/bg_search_bar</item>
		<item name="colorSeparator">@color/separator</item>
		<item name="colorDropZone">@color/bg_drop_zone</item>
	</style>
	<style name="HomeTheme.Light" parent="android:Theme.DeviceDefault.Light.NoActionBar">
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:windowShowWallpaper">true</item>
		<item name="android:alertDialogTheme">@style/LightDialog</item>
		<item name="android:textColorPrimary">#1c1b1f</item>
		<item name="android:textColorSecondary">#757575</item>
		<item name="colorUiBackground">#d0ffffff</item>
		<item name="colorSearchBar">#e8ffffff</item>
		<item name="colorSeparator">#1f000000</item>
		<item name="colorDropZone">#60ffffff</item>
	</style>
	<style name="Toolbar" parent="@android:style/Widget.TextView">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:padding">16dp</item>
		<item name="android:layout_marginBottom">1dp</item>
		<item name="android:drawablePadding">32dp</item>
		<item name="android:background">?attr/colorSearchBar</item>
		<item name="android:textColor">?android:attr/textColorPrimary</item>
		<item name="android:textSize">20sp</item>
		<item name="android:textStyle">bold</item>
	</style>
	<style name="CategoryHeader" parent="@android:style/Widget.TextView">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:padding">16dp</item>
		<item name="android:textColor">?android:attr/colorAccent</item>
		<item name="android:textSize">14sp</item>
		<item name="android:textStyle">bold</item>
	</style>
	<style name="PreferenceGroup">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:orientation">vertical</item>
		<item name="android:layout_marginLeft">16dp</item>
		<item name="android:layout_marginRight">16dp</item>
		<item name="android:layout_marginStart">16dp</item>
		<item name="android:layout_marginEnd">16dp</item>
		<item name="android:layout_marginBottom">20dp</item>
		<item name="android:background">@drawable/group_background</item>
	</style>
	<style name="Preference" parent="@android:style/Widget.TextView">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:padding">16dp</item>
		<item name="android:textColor">?android:attr/textColorSecondary</item>
		<item name="android:lineSpacingExtra">3dp</item>
	</style>
	<style name="PreferenceWithSeparator" parent="Preference">
		<item name="android:background">@drawable/bottom_border</item>
	</style>
	<style name="Button" parent="@android:style/Widget.Button">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:background">@drawable/button_raised</item>
		<item name="android:padding">16dp</item>
		<item name="android:textColor">@color/button_text</item>
		<item name="android:textStyle">bold</item>
	</style>
	<style name="DarkDialog" parent="android:Theme.DeviceDefault.Dialog.Alert"/>
	<style name="LightDialog" parent="android:Theme.DeviceDefault.Light.Dialog.Alert"/>
</resources>
